{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hiretab-admin.gdsc.dev" }],
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/login",
      "has": [{ "type": "host", "value": "hiretab.gdsc.dev" }],
      "destination": "https://hiretab-admin.gdsc.dev/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
